# ─────────────────────────────────────────────────────────────
#  DealHawk Listener — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# ── Telegram API (from https://my.telegram.org/auth) ─────────
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+91XXXXXXXXXX

# ── StringSession (generated by auth.py — for cloud deployment)
# Leave empty when running locally for the first time.
# After running `python auth.py`, paste the output here.
TELEGRAM_STRING_SESSION=

# ── Channels to monitor ────────────────────────────────────────
# Comma-separated Telegram channel usernames or numeric IDs.
# Your account must have already JOINED these channels.
# Example: @DealsDhamaka,@LootDeals,-1001234567890
TELEGRAM_CHANNELS=@grabdeals16,@nonstopdeals,-1001191090845,@DealsDhamaka,@LootDeals,@FreeKaaMaal,@TrickXpert,@IndiaLootDeals

# ── Supabase (use SERVICE ROLE key — bypasses RLS for inserts) ─
# Dashboard → Settings → API → service_role key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key-here

# ── Cuelinks Affiliate API (Optional for Phase 4) ─────────────
# Sign up at https://cuelinks.com to get your API key.
# If left blank, deals are saved with raw product URLs.
CUELINKS_API_KEY=

